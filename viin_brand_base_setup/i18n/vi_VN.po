#: model_terms:ir.ui.view,arch_db:viin_brand_base_setup.res_config_settings_view_form
msgid ""
"This name will be used for the application when it is installed through the "
"browser."
msgstr ""
"Tên này sẽ được sử dụng cho ứng dụng khi được cài đặt qua trình duyệt."

#. module: viin_brand_base_setup
#: model_terms:ir.ui.view,arch_db:viin_brand_base_setup.res_config_settings_view_form
