<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.setting.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//a[@href='https://play.google.com/store/apps/details?id=com.odoo.mobile']" position="attributes">
                <attribute name="href">https://play.google.com/store/apps/details?id=com.viindoo</attribute>
            </xpath>
            <xpath expr="//a[@href='https://itunes.apple.com/us/app/odoo/id1272543640']" position="attributes">
                <attribute name="href">https://apps.apple.com/vn/app/viindoo-mobile/id1562267579</attribute>
            </xpath>
        </field>
    </record>
</odoo>
