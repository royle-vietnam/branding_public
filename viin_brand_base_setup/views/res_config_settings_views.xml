<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.viin_brand_common</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[./field[@name='web_app_name']]" position="attributes">
                <attribute name="help">This name will be used for the application when it is installed through the browser.</attribute>
            </xpath>
            <xpath expr="//field[@name='web_app_name']" position="attributes">
                <attribute name="placeholder">Viindoo</attribute>
            </xpath>
            <xpath expr="//setting[@id='partner_autocomplete']" position="attributes">
                <attribute name="title">When populating your address book, the system provides a list of matching companies. When selecting one item, the company data and logo are auto-filled.</attribute>
            </xpath>
            <xpath expr="//setting[.//button[@name='%(base.action_apikeys_admin)d']]" position="attributes">
                <attribute name="help">API Keys allow your users to access the system with external tools when multi-factor authentication is enabled.</attribute>
            </xpath>
        </field>
    </record>
</odoo>
