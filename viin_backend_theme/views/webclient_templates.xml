<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Boot reflection (FOUC free): stamp the theme owned density attribute onto the html root so the
         backend renders the correct row density on the very first server render, before any JS runs.
         data-viin-density comes from the viin_density cookie, defaulting to comfortable.

         T-5 (PR #658): the color_scheme (data-bs-theme) reflection MOVED to viin_brand_common - the
         base now owns dark mode end to end (recompiled web.assets_web_dark bundle + ir.http.color_scheme
         + boot stamp), so dark works even without this redesign theme. Only the density reflection,
         which is theme owned, stays here. -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap"
              name="web.webclient.bootstrap.inherit.viin.backend.theme">
        <xpath expr="//t[@t-set='body_classname']" position="after">
            <t t-set="html_data" t-value="dict(html_data or {}, **{
                'data-viin-density': request.httprequest.cookies.get('viin_density', 'comfortable'),
            })"/>
        </xpath>
        <!-- T-5 (PR #658): allow pinch to zoom (WCAG SC 1.4.4). Core web.webclient_bootstrap sets
             user-scalable=no on the viewport meta; override it to permit user scaling of the backend. -->
        <xpath expr="//meta[@name='viewport']" position="attributes">
            <attribute name="content">width=device-width, initial-scale=1</attribute>
        </xpath>
    </template>
</odoo>
