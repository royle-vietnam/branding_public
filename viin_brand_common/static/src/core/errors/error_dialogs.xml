<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension" owl="1">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">Session Expired</attribute>
        </xpath>
        <xpath expr="//p[@class='text-prewrap']" position="replace" mode="inner">
            Your session expired. The current page is about to be refreshed.
        </xpath>
    </t>

</templates>
