"        <tr><td style=\"text-align: center; font-size: 13px;\">\n"
"        Powered by <a target=\"_blank\" href=\"https://viindoo.com?utm_source=db&amp;utm_medium=email\" style=\"color: #875A7B;\">Viindoo</a>\n"
"        </td></tr>\n"
"    </table>\n"
"</td></tr>\n"
"</table>"
