<?xml version="1.0" encoding="utf-8"?>
<template>
    <t t-inherit="web.MobileAppsFunnel" t-inherit-mode="extension">
        <xpath expr="//a[contains(@href, 'play.google.com')]" position="attributes">
            <attribute name="href">https://play.google.com/store/apps/details?id=com.viindoo</attribute>
        </xpath>
        <xpath expr="//a[contains(@href, 'itunes.apple.com')]" position="attributes">
            <attribute name="href">https://apps.apple.com/vn/app/viindoo-mobile/id1562267579</attribute>
        </xpath>
    </t>
</template>
