#. module: viin_brand_payment
#: model:ir.model.fields,field_description:viin_brand_payment.field_payment_provider__capture_manually
msgid "Capture Amount Manually"
msgstr "Ghi số tiền theo cách thủ công"

#. module: viin_brand_payment
#: model:ir.model.fields,help:viin_brand_payment.field_payment_provider__capture_manually
msgid ""
"Capture the amount from the system, when the delivery is completed.\n"
"Use this if you want to charge your customers cards only when\n"
"you are sure you can ship the goods to them."
msgstr ""
"Chỉ ghi nhận thanh toán sau khi đơn hàng đã giao xong.\n"
"Dùng khi bạn muốn chỉ trừ tiền khách hàng khi chắc chắn có thể giao hàng thành công."

