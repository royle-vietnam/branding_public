#: model:ir.model.fields,help:viin_brand_payment.field_payment_provider__support_refund
msgid ""
"Refund is a feature allowing to refund customers directly from the payment "
"in the system."
msgstr ""
"Hoàn tiền cho phép bạn trả lại tiền cho khách hàng trực tiếp từ giao dịch thanh toán trên hệ thống."
