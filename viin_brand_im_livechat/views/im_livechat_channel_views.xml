<odoo>
	<record id="im_livechat_channel_view_form" model="ir.ui.view">
	    <field name="name">im_livechat.channel.form</field>
	    <field name="model">im_livechat.channel</field>
	    <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
	    <field name="priority">110</field>
	    <field name="arch" type="xml">
			<xpath expr="//page[@name='Agents']//p[hasclass('text-muted')]" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//page[@name='Agents']//p[hasclass('text-muted')]" position="after">
				<p class="text-muted" colspan="2">Agents who are inactive in the system for more than 30 minutes will be considered disconnected.</p>
			</xpath>
			<xpath expr="//page[@name='configuration_widget']//separator[1]" position="attributes">
				<attribute name="string">FOR WEBSITES BUILT WITH VIINDOO</attribute>
			</xpath>
	    </field>
	</record>
</odoo>
