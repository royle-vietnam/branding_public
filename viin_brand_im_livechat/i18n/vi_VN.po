#. module: im_livechat
#: model_terms:digest.tip,tip_description:im_livechat.digest_tip_im_livechat_0
msgid ""
"Use canned responses to define templates\n"
"                        of\n"
"                        messages in the livechat app. To load a canned\n"
"                        response, start your sentence with ':' and select\n"
"                        the template."
msgstr ""
"Sửa dụng các câu trả lời mẫu để định nghĩa các mẫu tin nhắn\n "
"                         ở\n "
"                         ứng dụng chat trực tuyến. Để sử dụng câu trả lời mẫu\n"
"                         khi chat, hãy bắt đầu gõ ':' (hai chấm) và chọn\n"
"                         mẫu sổ ra."
