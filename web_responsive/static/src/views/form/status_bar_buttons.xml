<templates>
    <t
        t-name="web_responsive.StatusBarButtons"
        t-inherit="web.StatusBarButtons"
        t-inherit-mode="extension"
    >
        <!-- Odoo 19 merged web.StatusBarDropdownItems into web.StatusBarButtons: the
             small-screen ("More") branch now renders its own <Dropdown> with a single
             <DropdownItem> per overflowed slot. DropdownItem has never exposed a bare
             "hotkey" prop (it was dropped from its props schema by the "Dropdown
             unification" refactor already on 18.0 - the previous hotkey='shift+a'
             attribute was therefore silently ignored even before this port, and would
             now throw "Invalid props" since QWeb/OWL apps run in dev mode whenever
             session.test_mode is set). The supported way to add a DOM data-hotkey to a
             DropdownItem is via its "attrs" prop, which it forwards verbatim onto the
             rendered node (see web/.../core/dropdown/dropdown_item.xml,
             t-att="props.attrs") - the same convention core itself uses, e.g.
             web/.../views/view_components/view_scale_selector.xml
             attrs="{ 'data-hotkey': scale.hotkey or scale.key[0] }". -->
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="attrs">{ 'data-hotkey': 'shift+a' }</attribute>
        </xpath>
    </t>
</templates>
